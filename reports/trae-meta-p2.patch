+// decorateUsage 把 SOLO token_usage 里的 Anthropic 风格缓存字段（顶层平铺的
+// cache_read_input_tokens / reasoning_tokens）转换成 OpenAI 客户端读取的
+// prompt_tokens_details.cached_tokens / completion_tokens_details.reasoning_tokens。
+// 不转换的话 OpenAI 兼容客户端（Codex / Cherry 等）永远显示不出缓存命中。
+// 2026-10-19 实测字段名；上游原始字段保留不动，便于排查。
+func decorateUsage(usage map[string]any) map[string]any {
+	if usage == nil {
+		return nil
+	}
+	cacheRead, _ := usage["cache_read_input_tokens"].(float64)
+	details, hasDetails := usage["prompt_tokens_details"].(map[string]any)
+	if !hasDetails {
+		details = map[string]any{}
+	}
+	if _, exists := details["cached_tokens"]; !exists {
+		details["cached_tokens"] = int64(cacheRead)
+	}
+	usage["prompt_tokens_details"] = details
+
+	if reasoning, _ := usage["reasoning_tokens"].(float64); reasoning > 0 {
+		outDetails, hasOut := usage["completion_tokens_details"].(map[string]any)
+		if !hasOut {
+			outDetails = map[string]any{}
+		}
+		if _, exists := outDetails["reasoning_tokens"]; !exists {
+			outDetails["reasoning_tokens"] = int64(reasoning)
+		}
+		usage["completion_tokens_details"] = outDetails
+	}
+	return usage
+}
